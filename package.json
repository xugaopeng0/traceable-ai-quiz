{
  "name": "traceable-ai-quiz",
  "version": "0.1.0",
  "private": true,
  "description": "可溯源 AI 出题与生成质量评测模块：规划工具",
  "scripts": {
    "api:sync": "node scripts/sync-openapi.mjs",
    "api:check": "node scripts/sync-openapi.mjs --check",
    "check": "node scripts/check.mjs",
    "test:skeleton": "node scripts/skeleton-smoke.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "spec:list": "openspec list",
    "spec:status": "openspec status --change define-traceable-quiz-platform",
    "spec:validate": "openspec validate --all --strict"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.13.1",
    "@playwright/test": "1.63.0"
  }
}
