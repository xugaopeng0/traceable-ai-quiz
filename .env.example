# Docker Compose 运行配置。复制为 .env；本文件不含密钥，骨架不需要数据库或 AI 网关。
COMPOSE_PROJECT_NAME=traceable-ai-quiz
APP_ENV=dev
APP_NAME=traceable-ai-quiz
APP_VERSION=0.0.1-skeleton
BUILD_COMMIT=development
LOG_LEVEL=INFO
WEB_BIND_HOST=127.0.0.1
WEB_PORT=18080
WEB_LISTEN_PORT=8080
API_HOST=api
API_LISTEN_HOST=0.0.0.0
API_PORT=8081
HTTP_READ_TIMEOUT_SECONDS=5
HTTP_WRITE_TIMEOUT_SECONDS=10
HTTP_IDLE_TIMEOUT_SECONDS=60
SHUTDOWN_TIMEOUT_SECONDS=15
PROXY_TIMEOUT_SECONDS=5
PROXY_CONNECT_TIMEOUT_SECONDS=1
PUBLIC_HEALTH_TIMEOUT_MS=5000
HEALTHCHECK_INTERVAL=10s
HEALTHCHECK_TIMEOUT=2s
HEALTHCHECK_RETRIES=3
HEALTHCHECK_START_PERIOD=5s
STOP_GRACE_PERIOD=30s
# 同一内容按摘要锁定，升级镜像需单独评审。
GO_IMAGE=golang:1.26-alpine@sha256:8ac98ca534ac3f51e1f420a1dd2c15e74c75cfa0f23f3ad27eb5d7236c349a0c
NODE_IMAGE=node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1
NGINX_IMAGE=nginx:1.28-alpine@sha256:a8b39bd9cf0f83869a2162827a0caf6137ddf759d50a171451b335cecc87d236
ALPINE_IMAGE=alpine:3.23@sha256:85fe1e81d6758c208f3e1eed4338a1997e19d4be002d4dd32d3100c9a8c010a0
